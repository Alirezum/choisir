{
  "name": "choosier-frontend",
  "private": true,
  "version": "0.3.0",
  "description": "Vue single-page frontend for the choosier web UI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "generate:api": "node scripts/generate-api-contract.mjs",
    "check:api": "node scripts/generate-api-contract.mjs --check",
    "check:ui": "node scripts/check-ui-boundaries.mjs",
    "test:api": "node --test \"tests/**/*.test.mjs\"",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/archivo-narrow": "^5.3.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.13"
  }
}
